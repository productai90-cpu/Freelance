# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# .env.local is gitignored. These two are safe to publish anyway —
# the anon key grants only what the RLS policies in
# supabase/schema.sql allow — but never put the SERVICE ROLE key
# here. Anything prefixed VITE_ is compiled into the public bundle,
# and the service role key bypasses every policy.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
